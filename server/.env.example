# =============================================
# Smart Expense Tracker - Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to Git!

# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Example: mongodb+srv://username:password@cluster.mongodb.net/expensetracker
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/expensetracker

# JWT Secret Key
# Use a long random string - this signs your authentication tokens
# You can generate one at: https://randomkeygen.com/
JWT_SECRET=your_super_secret_jwt_key_make_it_long_and_random_123456

# Server Port
# The port your backend server will run on
PORT=5000

# Client URL (for CORS - allows your frontend to talk to backend)
CLIENT_URL=http://localhost:3000
